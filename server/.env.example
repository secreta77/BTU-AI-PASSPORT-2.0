# Copy to .env in this folder (server/) and fill in. Never commit real values.
PORT=
# Base URL of the public site, used in the QR link. Default: http://localhost:4200
PUBLIC_BASE_URL=
DATABASE_URL=
GOOGLE_SHEET_ID=
# Path of the Google service-account key. Empty = ./credentials/google-service-account.json (relative to server/).
# On Render: add a Secret File with that file name (it appears in /etc/secrets/) and set /etc/secrets/google-service-account.json here.
# GOOGLE_APPLICATION_CREDENTIALS (Google's usual name) works as well.
GOOGLE_CREDENTIALS_PATH=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
ISSUER_PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=
# 2–3 public RPC URLs separated by commas (fallback order)
RPC_URLS=
# Public RPC URLs for the browser, comma-separated. Public URLs only, no API keys
PUBLIC_RPC_URLS=
# Secret salt for passportRef = keccak256(passportId + salt). Never change it after the first issue
PASSPORT_REF_SALT=
# Leave SMTP_* empty in dev: Ethereal test account is used
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Brevo mail API (HTTPS). When BREVO_API_KEY is set, login mails go through Brevo and SMTP_* is ignored.
# Use it on hosts that block SMTP ports (Render free). MAIL_FROM = a sender address confirmed in Brevo (Senders).
BREVO_API_KEY=
MAIL_FROM=
JWT_SECRET=
ADMIN_API_KEY=
# Minutes between automatic syncs (for example 30). Empty or 0 = off. A sleeping Render free instance has no timer:
# keep it awake with an uptime monitor on /api/health.
AUTO_SYNC_MINUTES=
